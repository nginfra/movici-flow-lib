{
  "name": "@nginfra/movici-flow-lib",
  "version": "1.5.0",
  "type": "module",
  "sideEffects": ["**/*.css", "**/*.scss"],
  "files": ["dist", "src", "public/static"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "default": "./dist/types/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js",
      "default": "./dist/api/index.js"
    },
    "./api/client": {
      "types": "./dist/api/client.d.ts",
      "import": "./dist/api/client.js",
      "default": "./dist/api/client.js"
    },
    "./api/requests/base": {
      "types": "./dist/api/requests/base.d.ts",
      "import": "./dist/api/requests/base.js",
      "default": "./dist/api/requests/base.js"
    },
    "./stores/flow": {
      "types": "./dist/stores/flow.d.ts",
      "import": "./dist/stores/flow.js",
      "default": "./dist/stores/flow.js"
    },
    "./baseComposables/useSnackbar": {
      "types": "./dist/baseComposables/useSnackbar.d.ts",
      "import": "./dist/baseComposables/useSnackbar.js",
      "default": "./dist/baseComposables/useSnackbar.js"
    },
    "./crs": {
      "types": "./dist/crs.d.ts",
      "import": "./dist/crs.js",
      "default": "./dist/crs.js"
    },
    "./locales": {
      "types": "./dist/locales/index.d.ts",
      "import": "./dist/locales/index.js",
      "default": "./dist/locales/index.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "import": "./dist/version.js",
      "default": "./dist/version.js"
    },
    "./views/FlowMainView.vue": {
      "types": "./dist/views/FlowMainView.vue.d.ts",
      "import": "./dist/views/FlowMainView.js",
      "default": "./dist/views/FlowMainView.js"
    },
    "./style.css": "./dist/assets/index.css",
    "./scss/variables": "./src/assets/sass/variables.scss",
    "./scss/helpers": "./src/assets/sass/helpers.scss",
    "./scss/style": "./src/assets/sass/style.scss",
    "./static/*": "./public/static/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "type-check": "vue-tsc --noEmit -p tsconfig.lib.json",
    "test:unit": "vitest --config project/vitest.config.ts",
    "generateIcons": "cd icon_generation/ && node generateIconAtlasMapping.js icons shapes --img-output-dir ../public/static/icons --json-output-dir ../src/assets/icons",
    "format": "prettier --write src/ project/",
    "lint:format": "prettier --check src/ project/"
  },
  "peerDependencies": {
    "vue": "^3.5.25",
    "vue-i18n": "^11.2.2",
    "vue-router": "^4.6.3",
    "pinia": "^3.0.4",
    "@oruga-ui/oruga-next": "^0.13.6",
    "@oruga-ui/theme-bulma": "^0.9.0",
    "bulma": "^1.0.4",
    "@deck.gl/core": "^9.3.5",
    "@deck.gl/layers": "^9.3.5",
    "@deck.gl/extensions": "^9.3.5",
    "@deck.gl-community/editable-layers": "^9.3.7",
    "@luma.gl/core": "^9.3.5",
    "@luma.gl/engine": "^9.3.5",
    "mapbox-gl": "^3.16.0"
  },
  "dependencies": {
    "@ckpack/vue-color": "^1.6.0",
    "@placemarkio/geo-viewport": "^1.0.2",
    "@turf/helpers": "^7.3.1",
    "@turf/nearest-point-on-line": "^7.3.1",
    "axios": "^1.13.2",
    "chart.js": "^4.5.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "geotiff": "^2.1.3",
    "lodash": "^4.17.21",
    "proj4": "^2.20.2",
    "reproject": "^1.2.7",
    "vue-chartjs": "^5.3.3",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/lodash": "^4.17.21",
    "@types/node": "^24.10.1",
    "@types/proj4": "^2.5.6",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/tsconfig": "^0.8.1",
    "glob": "^11.0.0",
    "prettier": "3.9.4",
    "sass-embedded": "^1.93.3",
    "typescript": "~5.9.3",
    "vite": "^7.2.6",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vue-tsc": "^3.1.7",
    "vitest": "^4.0.15",
    "jsdom": "^22.1.0"
  }
}
